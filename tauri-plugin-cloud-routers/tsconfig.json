{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "outDir": "dist-js",
    "rootDir": "guest-js",
    "skipLibCheck": true
  },
  "include": ["guest-js/**/*.ts"]
}